# ---------------------------------------------------------------------------
# Local with Docker Compose (here "postgres" is the docker service name)
DATABASE_URL=postgresql+psycopg2://postgres:Baymax%408600@postgres:5432/inventory_db

# Local WITHOUT Docker (uncomment and use this instead)
# DATABASE_URL=postgresql+psycopg2://postgres:Baymax%408600@localhost:5432/inventory_db

# Deployed backend (Render / Railway / Supabase / Neon) - set this in the
# platform's Environment Variables, never hardcode it:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB_NAME

# Port the server listens on (hosting platforms inject this automatically)
PORT=8000
